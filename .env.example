# إعدادات مشروع Supabase (انسخها من Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# إعدادات الخرائط والتتبع الجغرافي الحي (Mapbox + Google Places + Traccar GPS Server)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key
NEXT_PUBLIC_TRACCAR_WS_URL=wss://traccar.yourdomain.com/api/socket

# إعدادات الإشعارات الفورية (Firebase Cloud Messaging / OneSignal)
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
